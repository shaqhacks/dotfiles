[init]
	defaultBranch = main

[color]
	ui = auto

[fetch]
	prune = true

[pull]
	ff = only

[push]
	autoSetupRemote = true

[include]
	path = ~/.gitconfig.local
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	side-by-side = true
	navigate = true
	line-numbers = true
[merge]
	conflictstyle = zdiff3

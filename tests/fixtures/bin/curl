#!/usr/bin/env bash

printf 'curl %s\n' "$*" >>"${DOTFILES_STUB_LOG}"

if [ "${DOTFILES_STUB_CURL_FAIL:-0}" = 1 ]; then
  exit 44
fi

output=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    -o)
      shift
      output="$1"
      ;;
  esac
  shift
done

if [ -n "${output}" ]; then
  printf '%s\n' '#!/usr/bin/env bash' 'exit 0' >"${output}" || exit 1
fi

exit 0
